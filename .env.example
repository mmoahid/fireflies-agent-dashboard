# Prisma (Supabase Postgres)
# `DATABASE_URL` should usually be your Supabase "Connection pooling" URL (PgBouncer) for app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# `DIRECT_URL` should be your Supabase "Direct connection" URL for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Fireflies + Gemini (used by server/worker)
FIREFLIES_API_KEY="YOUR_FIREFLIES_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Shared login (Basic Auth)
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="change-me"

# Python worker (Supabase REST API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
